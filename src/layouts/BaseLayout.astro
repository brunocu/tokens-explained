---
import { Font } from "astro:assets";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/tokens.css";
import "../styles/island.css";
import "../styles/widget.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <Font cssVariable="--font-serif" preload={[{ weight: 400, style: "normal" }]} />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <!-- Failed-to-load watcher (D-09), for every interactive card (every [data-island]). Inline on
         purpose: it must not depend on any bundled asset that could itself fail to load. Each card
         gets its own observer and its own timer, started when that card first enters the viewport
         (not at page load), because an island only hydrates once its card is near the viewport.
         A late hydration recovers the card: the island sets data-state back to ready. The Reload
         page buttons have no framework handler, so one delegated click listener serves them all. -->
    <script is:inline>
      (function () {
        document.addEventListener("click", function (e) {
          var t = e.target;
          if (t && t.closest && t.closest("[data-reload]")) location.reload();
        });
        if (!("IntersectionObserver" in window)) return;
        var cards = document.querySelectorAll("[data-island]");
        Array.prototype.forEach.call(cards, function (card) {
          var io = new IntersectionObserver(function (entries) {
            var seen = false;
            for (var i = 0; i < entries.length; i++) if (entries[i].isIntersecting) seen = true;
            if (!seen) return;
            io.disconnect();
            setTimeout(function () {
              if (card.getAttribute("data-state") === "loading") card.setAttribute("data-state", "failed");
            }, 8000);
          });
          io.observe(card);
        });
      })();
    </script>
  </body>
</html>
