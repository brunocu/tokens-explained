---
// One post through the shared shell: H1, deck, the MDX body with its closed component
// vocabulary (TokenFigure and, from plan 02-10, Fact, TextAsNumbers; citations and the bibliography are
// generated by rehype-citation from [@key] and src/data/references.bib), then space at the
// end. No footer, no next-post link (UI-SPEC post end, D-12, D-14). The playground, the stepper, the comparison and
// the languages widget are not in this map: a hydrated island needs its import in the MDX itself (RESEARCH G-1), so
// the MDX imports them and their props.
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TokenFigure from "../components/prose/TokenFigure.astro";
import Fact from "../components/prose/Fact.astro";
import TextAsNumbers from "../components/prose/TextAsNumbers.astro";

interface Props {
  post: CollectionEntry<"posts">;
  canonical: string;
}

const { post, canonical } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.deck} canonical={canonical}>
  <article>
    <header>
      <h1>{post.data.title}</h1>
      <p class="deck">{post.data.deck}</p>
    </header>
    <Content components={{ TokenFigure, Fact, TextAsNumbers }} />
  </article>
</BaseLayout>

<style>
  .deck {
    margin: 0;
    color: var(--muted);
  }
  article {
    padding-bottom: var(--space-3xl);
  }
  /* The citations and the bibliography are generated by rehype-citation, so their markup has no
     component scope: these rules use :global. */
  article :global(span.cites) {
    white-space: nowrap;
  }
  article :global(#refs .csl-entry) {
    display: flex;
    gap: var(--space-sm);
    margin: 0 0 var(--space-sm);
    font: 400 16px/1.5 var(--font-sans);
  }
  article :global(#refs .csl-entry:target) {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }
  article :global(#refs .csl-left-margin) {
    flex: none;
    min-width: 2.25em;
  }
  article :global(#refs .csl-right-inline) {
    min-width: 0;
    overflow-wrap: anywhere;
  }
</style>
