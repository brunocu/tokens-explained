---
// The playground section of a post. The heading id is fixed here because ids generated
// for headings inside MDX are fragile (research Pattern 4).
//
// The island hydrates at page load (client:load, D-04), so its tokenizer download starts at once.
// Until that file arrives the island shows tokens it cannot compute yet: this wrapper cuts the
// committed comparison fixture down to six texts (the default text and the five examples) and
// passes them as a prop. The island never imports the fixture itself (research Pitfall 6).
import Playground from "../Playground.svelte";
import { COMPARISON } from "../../core/compare/comparison.ts";
import type { FixtureToken } from "../../core/compare/fixture.ts";
import { DEFAULT_TEXT, EXAMPLES } from "../../core/examples.ts";

const preTokens: Record<string, FixtureToken[]> = { [DEFAULT_TEXT]: COMPARISON.defaultText.gpt2 };
for (const example of EXAMPLES) {
  const row = COMPARISON.examples.find((e) => e.id === example.id);
  if (row === undefined) {
    throw new Error(`PlaygroundSection: example "${example.id}" is missing from comparison.json (run npm run precompute:comparison)`);
  }
  preTokens[example.text] = row.rows.gpt2;
}
const sizeLabel = COMPARISON.meta.download.gpt2.sizeLabelMb;
---

<section aria-labelledby="try-heading" class="playground-section">
  <h2 id="try-heading">Try it yourself</h2>
  <p><slot /></p>
  <Playground client:load preTokens={preTokens} sizeLabel={sizeLabel} />
</section>
