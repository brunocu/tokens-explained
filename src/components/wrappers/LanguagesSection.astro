---
// The languages section of a post. The heading id is fixed here because ids generated for
// headings inside MDX are fragile (research Pattern 4). The table is static HTML in its own card;
// the optional "Look inside" picker is the island, in a second card of the same chrome.
import LanguagesDemo from "../LanguagesDemo.svelte";
import LanguagesTable from "../LanguagesTable.astro";
---

<section aria-labelledby="languages-heading" class="languages-section">
  <h2 id="languages-heading">The same sentence in other languages</h2>
  <p><slot /></p>
  <div class="island-card" data-languages-card>
    <LanguagesTable />
  </div>
  <div class="look-inside">
    <LanguagesDemo client:visible />
  </div>
</section>

<style>
  .look-inside {
    margin-top: var(--space-lg);
  }
</style>
