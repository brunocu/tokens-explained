---
// The stepper section of a post. The heading id is fixed here because ids generated
// for headings inside MDX are fragile (research Pattern 4).
import BpeStepper from "../BpeStepper.svelte";
---

<section aria-labelledby="stepper-heading" class="stepper-section">
  <h2 id="stepper-heading">Build a vocabulary yourself</h2>
  <p><slot /></p>
  <BpeStepper client:visible />
</section>
