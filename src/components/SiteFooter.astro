---
// Plain-text licence statement (D-05). No links on purpose: the dist guard only allows
// anchors to the reference and UDHR hosts, and the full terms live in the project README.
---

<footer class="site-footer">
  <div class="inner">
    <p>
      The code of this site is MIT licensed and its text and figures are CC BY 4.0. The tokenizer files and the
      fonts keep their own licences, as described in the project README.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    box-sizing: border-box;
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--border);
  }
  .inner {
    box-sizing: border-box;
    max-width: 680px;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
  }
  @media (min-width: 640px) {
    .inner {
      padding: var(--space-lg) var(--space-lg);
    }
  }
  p {
    margin: 0;
    font: 400 14px/1.5 var(--font-sans);
    color: var(--muted);
  }
</style>
