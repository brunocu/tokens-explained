---
// One IEEE reference. The entry text is the slot; the link and the access date are added here so
// every entry looks the same. `accessed` is given only for web sources. The id is the target of
// the [n] citation links in the prose.
interface Props {
  n: number;
  url: string;
  accessed?: string;
}

const { n, url, accessed } = Astro.props;
---
<li id={`ref-${n}`} class="reference">
  <span class="ref-n">[{n}]</span>
  <div class="ref-body">
    <slot />
    {" "}[Online]. Available: <a href={url} rel="noopener noreferrer">{url}</a>.{accessed ? ` Accessed: ${accessed}.` : ""}
  </div>
</li>
<style>
  .reference {
    display: flex;
    gap: var(--space-sm);
    margin: 0 0 var(--space-sm);
    font: 400 16px/1.5 var(--font-sans);
  }
  .reference:target {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }
  .ref-n {
    flex: none;
    min-width: 2.25em;
  }
  .ref-body {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .ref-body :global(p) {
    display: inline;
    margin: 0;
  }
</style>