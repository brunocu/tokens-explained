---
// Build-time static token display for prose (TOK-10, Pitfall 4, D-11). Every figure is cut by
// the real GPT-2 tokenizer at build time, and every count in the post comes from it; no number
// is typed into prose. A false claim fails the build. Rendered without a client directive:
// static HTML, no script.
import TokenDisplay from "../TokenDisplay.svelte";
import { buildGpt2 } from "../../core/buildTokenizer.ts";
import { groupBytes } from "../../core/chars.ts";
import { countCompositeCharacters, countSplitCharacters, countWords } from "../../core/counts.ts";
import { assertClaims, type Claim } from "../../core/claims.ts";
import { SAMPLE_SENTENCE } from "../../core/stepper.ts";

// `sample` cuts the stepper's own sample sentence (the constant, never retyped) and marks the
// figure data-figure="sample" so tests can tell it from the other two.
interface Props {
  text?: string;
  sample?: boolean;
  expect?: Claim[];
  legend?: boolean;
}

const { text: givenText, sample = false, expect: claims, legend = false } = Astro.props;
const text = sample ? SAMPLE_SENTENCE : givenText;
if (text === undefined) throw new Error("TokenFigure needs a text or the sample prop");

const gpt2 = await buildGpt2();
const tokens = gpt2.tokenize(text);
assertClaims(text, claims ?? [], gpt2);

const splitCount = countSplitCharacters(text, tokens);
// Prose figures are one-line chips with no hex on normal chips, so the third argument is false, same rule as the playground.
const compositeCount = countCompositeCharacters(text, groupBytes(tokens), false);
const words = countWords(text);
const caption = `${words} ${words === 1 ? "word" : "words"}, ${tokens.length} ${tokens.length === 1 ? "token" : "tokens"}`;
---

<figure class="token-figure" data-figure={sample ? "sample" : undefined}>
  <TokenDisplay tokens={tokens} splitCount={splitCount} compositeCount={compositeCount} legend={legend} emptyState={false} />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .token-figure {
    box-sizing: border-box;
    margin: var(--space-lg) 0;
    padding: var(--space-md);
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  @media (min-width: 640px) {
    .token-figure {
      padding: var(--space-lg);
    }
  }
  figcaption {
    margin-top: var(--space-md);
    font: 600 14px/1.4 var(--font-sans);
    color: var(--muted);
  }
</style>
