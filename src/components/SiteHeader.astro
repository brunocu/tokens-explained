---
// Site name link only (D-14): no menu, no toggle, no other links.
const home = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="inner">
    <a href={home}>Tokenizer Vis</a>
  </div>
</header>

<style>
  .site-header {
    box-sizing: border-box;
    height: 48px;
    border-bottom: 1px solid var(--border);
  }
  .inner {
    box-sizing: border-box;
    max-width: 680px;
    height: 100%;
    margin: 0 auto;
    padding: 0 var(--space-md);
    display: flex;
    align-items: center;
  }
  @media (min-width: 640px) {
    .inner {
      padding: 0 var(--space-lg);
    }
  }
  a {
    font: 600 18px/1.6 var(--font-sans);
    color: var(--text);
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
